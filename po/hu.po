msgid_plural "{n} contacts were not copied: {e}"
msgstr[0] "{n} névjegyet nem sikerült másolni: {e}"
msgstr[1] "{n} névjegyet nem sikerült másolni: {e}"

msgid "{n} contact was not moved: {e}"
msgid_plural "{n} contacts were not moved: {e}"
msgstr[0] "{n} névjegyet nem sikerült áthelyezni: {e}"
msgstr[1] "{n} névjegyet nem sikerült áthelyezni: {e}"

msgid "Could not update contact: {e}"
msgstr "A névjegy nem frissíthető: {e}"

msgid "Could not import contacts: {e}"
msgstr "Nem sikerült importálni a névjegyeket: {e}"

msgid "Could not read: {files}"
msgstr "Nem sikerült beolvasni: {files}"

msgid "Search filters"
msgstr "Keresési szűrők"

msgid ""
"File or tag incoming mail automatically. Filters run on each Inbox as it "
"syncs; Apply Now runs them over the mail already there."
msgstr ""
"A bejövő leveleket automatikusan mappába rakja vagy megcímkézi. A szűrők "
"minden Beérkezett üzenetek mappán szinkronizáláskor futnak; az Alkalmazás "
"most a már ott lévő leveleken futtatja őket."

msgid "Add Filter…"
msgstr "Szűrő hozzáadása…"

msgid "Run every rule over the mail already in your inboxes"
msgstr "Futtasson minden szabályt a beérkező levelekben már meglévő leveleken"

msgid "GNOME Online Account"
msgstr "GNOME Internetes Fiók"

msgid "Show in Buzón"
msgstr "Megjelenítés a Buzónban"

msgid "Off returns it to the import list. It stays in GNOME Online Accounts."
msgstr ""
"Kikapcsolva visszakerül az importálási listába. A GNOME Online fiókokban "
"megmarad."

msgid ""
"Managed by GNOME Online Accounts. Its address, servers and password are "
"changed in Settings → Online Accounts."
msgstr ""
"A GNOME Online fiókok kezeli. A címét, a kiszolgálóit és a jelszavát a "
"Beállítások → Online fiókok részben lehet módosítani."

msgid "Storage"
msgstr "Tárhely"

msgid "Mail Account"
msgstr "Levelezési fiók"

msgid "Display Name"
msgstr "Megjelenítési név"

msgid "Email Address"
msgstr "E-mail-cím"

msgid "Incoming Protocol"
msgstr "Bejövő protokoll"

msgid "SMTP Server (optional)"
msgstr "SMTP kiszolgáló (nem kötelező)"

msgid "SMTP Port (default 587)"
msgstr "SMTP végpont (alapértelmezett: 587)"

msgid "Username"
msgstr "Felhasználónév"

msgid "Sign in with an API token"
msgstr "Bejelentkezés API-tokennel"

msgid "For servers, like Fastmail, that take a token instead of a password."
msgstr ""
"Olyan kiszolgálókhoz, mint a Fastmail, amelyek jelszó helyett tokent "
"fogadnak."

msgid "Advanced"
msgstr "Speciális"

msgid "Sign in with another app registration"
msgstr "Bejelentkezés másik alkalmazásregisztrációval"

msgid "Client ID"
msgstr "Ügyfélazonosító"

msgid "Tenant (common, organizations, consumers or an ID)"
msgstr "Bérlő (common, organizations, consumers vagy egy azonosító)"

msgid "Redirect URI"
msgstr "Átirányítási URI"

msgid "Sign In with Browser"
msgstr "Bejelentkezés böngészővel"

msgid ""
"Google and Microsoft sign in through GNOME Online Accounts. Sign in there, "
"then reopen this window and switch the account on under GNOME Online "
"Accounts."
msgstr ""
"A Google és a Microsoft a GNOME Online fiókokon keresztül jelentkezik be. "
"Jelentkezzen be ott, majd nyissa meg újra ezt az ablakot, és kapcsolja be a "
"fiókot a GNOME Online fiókokban."

msgid "Separate SMTP credentials"
msgstr "Külön SMTP hitelesítő adatok"

msgid "Off uses the credentials above."
msgstr "Kikapcsolva a fenti hitelesítő adatokat használja."

msgid "SMTP Username"
msgstr "SMTP Felhasználónév"

msgid "SMTP Password"
msgstr "SMTP Jelszó"

msgid "Accept a certificate for another name"
msgstr "Tanúsítvány elfogadása másik névhez"

msgid ""
"For shared hosting. Turn on only when the connection test says the names "
"differ."
msgstr ""
"Megosztott tárhelyhez. Csak akkor kapcsolja be, ha a kapcsolatteszt szerint "
"a nevek eltérnek."

msgid "Show in All Inboxes"
msgstr "Megjelenítés az összes beérkező levelek mappájában"

msgid "Also in the unified Starred, Sent, Drafts, Archive, Filters and Tags."
msgstr ""
"Az egyesített Csillagozottak, Elküldöttek, Piszkozatok, Archívum, Szűrők és "
"Címkék között is."

msgid "Test Connection"
msgstr "Kapcsolat tesztelése"

msgid "Account accent color"
msgstr "Fiók kiemelőszíne"

msgid "Use my Gravatar"
msgstr "Gravatarom használata"

msgid "Sends gravatar.com a hash of the address."
msgstr "A cím hash-ét küldi a gravatar.com-nak."

msgid "Circle shows"
msgstr "A kör megjelenítése"

msgid "Initials or emoji"
msgstr "Kezdőbetűk vagy hangulatjelek"

msgid "Picture"
msgstr "Kép"

msgid "Emoji"
msgstr "Hangulatjelek"

msgid "Instead of initials."
msgstr "A monogramok helyett."

msgid "Use initials"
msgstr "Használj kezdőbetűket"

msgid "Send-as aliases"
msgstr "Álnevek és címek (alias)"

msgid "Extra names and addresses this account can send as."
msgstr "További nevek és címek, amelyekkel ez a fiók küldhet."

msgid "Add Alias…"
msgstr "Álnév (alias) hozzáadása…"

msgid "Signatures"
msgstr "Aláírások"

msgid ""
"With more than one, the composer's signature button allows you to pick "
"between them."
msgstr ""
"Egynél több esetén a szerkesztő aláírásgombja lehetővé teszi, hogy válasszon "
"közülük."

msgid "Add Signature"
msgstr "Aláírás hozzáadása"

msgid "Import File…"
msgstr "Fájl importálása…"

msgid "Delete Signature"
msgstr "Aláírás törlése"

msgid "Sender name"
msgstr "Feladó neve"

msgid "Replaces the account's name in From. Aliases keep their own."
msgstr ""
"Felülírja a fiók nevét a Feladó mezőben. Az álnevek megtartják a sajátjukat."

msgid "Start messages with this signature"
msgstr "Az üzenetek kezdése ezzel az aláírással"

msgid "Syncing"
msgstr "Szinkronizálás"

msgid "Turn off for servers that stall on push connections."
msgstr "Kapcsolja ki a push-kapcsolatoknál akadozó kiszolgálók esetén."

msgid "Empty Junk automatically"
msgstr "Levélszemét automatikus kiürítése"

msgid "Empty Trash automatically"
msgstr "Kuka automatikus kiürítése"

msgid "Move list mail to Trash"
msgstr "Levelezőlista-levelek áthelyezése a Kukába"

msgid ""
"Inbox mail with an unsubscribe link older than this gets trashed unless it's "
"starred."
msgstr ""
"Az ennél régebbi, leiratkozási hivatkozást tartalmazó beérkezett levelek a "
"Kukába kerülnek, hacsak nincsenek csillagozva."

msgid "Keep mail cached"
msgstr "Levelek gyorsítótárban tartása"

msgid "Leaves out Trash, Junk and Drafts."
msgstr "Kihagyja a Kukát, a Levélszemetet és a Piszkozatokat."

msgid "Include attachments"
msgstr "Mellékletek belevétele"

msgid "Can consume a lot of hard drive space."
msgstr "Sok merevlemez-helyet foglalhat."

msgid "Copy mail to On This Computer"
msgstr "Levelek másolása az „Ezen a számítógépen” mappába"

msgid ""
"Downloads copies of every message from every folder of this account to this "
"computer (except Trash, Junk and Drafts) and stores them in On This Computer."
msgstr ""
"Másolatot tölt le a fiók minden mappájának minden üzenetéről erre a "
"számítógépre (a Kuka, a Levélszemét és a Piszkozatok kivételével), és az "
"„Ezen a számítógépen” tárolja őket."

msgid "Import"
msgstr "Importálás"

msgid "Mail already here is not imported again."
msgstr "A már itt lévő leveleket nem importálja újra."

msgid "Maildir folders"
msgstr "Maildir-mappák"

msgid "Evolution's On This Computer, Dovecot and other Maildir trees."
msgstr ""
"Az Evolution „Ezen a számítógépen” mappája, a Dovecot és más Maildir-fák."

msgid "Mbox files"
msgstr "Mbox-fájlok"

msgid "Thunderbird's folders and other mbox files."
msgstr "A Thunderbird mappái és más mbox-fájlok."

msgid "Microsoft 365"
msgstr "Microsoft 365"

msgid "Search the organization directory"
msgstr "Keresés a szervezet címtárában"

msgid "Suggests people from your organization as you type."
msgstr "Gépelés közben javasol embereket a szervezetéből."

msgid "Suggest only from this account"
msgstr "Javaslatok csak ebből a fiókból"

msgid "Suggestions come from the directory and this account's mail only."
msgstr ""
"A javaslatok csak a címtárból és ennek a fióknak a leveleiből származnak."

msgid "Show sensitivity label names"
msgstr "Érzékenységi címkék nevének megjelenítése"

msgid "Shows a label's name when a message gives only its ID."
msgstr ""
"Megjeleníti a címke nevét, ha egy üzenet csak az azonosítóját adja meg."

msgid "Folder Order"
msgstr "Mappák sorrendje"

msgid "Also in the right-click menu of its Folders heading."
msgstr "A Mappák címsorának jobb gombos menüjében is."

msgid "Special Folders"
msgstr "Speciális mappák"

msgid ""
"Follows the server's own markings unless you pick a folder. Nothing already "
"on the server moves."
msgstr ""
"A kiszolgáló saját jelölését követi, hacsak nem választ mappát. A "
"kiszolgálón már meglévő semmi sem mozdul."

msgid "Save a copy of sent mail in"
msgstr "Elküldött levelek másolatának mentése ide"

msgid "Save a copy of replies in"
msgstr "A válaszok másolatának mentése ide"

msgid "For Gmail and others that file sent mail themselves."
msgstr "A Gmailhez és másokhoz, amelyek maguk tárolják az elküldött leveleket."

msgid "Hidden Folders"
msgstr "Rejtett mappák"

msgid ""
"Hidden folders are not synced. Hide one from its right-click menu in the "
"sidebar."
msgstr ""
"A rejtett mappák nem szinkronizálódnak. Rejtsen el egyet az oldalsávon a "
"jobb gombos menüjéből."

msgid "No hidden folders."
msgstr "Nincsenek rejtett mappák."

msgid "Keys are managed under OpenPGP in the sidebar."
msgstr "A kulcsokat az oldalsáv OpenPGP része kezeli."

msgid "Automatic uses the key whose address matches."
msgstr "Az automatikus beállítás a megfelelő címhez tartozó kulcsot használja."

msgid "Sign messages by default"
msgstr "Üzenetek aláírása alapértelmezetten"

msgid "Hide the subject of encrypted mail"
msgstr "A titkosított levelek tárgyának elrejtése"

msgid "Only the recipients see the subject. Others see \"...\"."
msgstr "Csak a címzettek látják a tárgyat. Mások „...” jelet látnak."

msgid "Your password is kept in the system keyring, never in plain text."
msgstr ""
"A jelszavát a rendszer kulcstartója őrzi, soha nem egyszerű szövegként."

msgid "Search senders"
msgstr "Feladók keresése"

msgid "Allowed Senders"
msgstr "Engedélyezett feladók"

msgid "Messages from these senders load remote content automatically."
msgstr ""
"Az ezektől a feladóktól érkező üzenetek automatikusan betöltik a távoli "
"tartalmakat."

msgid "Allow this sender"
msgstr "Feladó engedélyezése"

msgid "Blocked Senders"
msgstr "Letiltott feladók"

msgid ""
"Their mail is moved to Trash on arrival. Enter an address, or a domain like "
"\"example.com\" to apply to all senders from that domain."
msgstr ""
"A leveleik érkezéskor a Kukába kerülnek. Adjon meg egy címet, vagy egy "
"tartományt, például „example.com”, hogy az adott tartomány minden feladójára "
"vonatkozzon."

msgid "Address or domain"
msgstr "Cím vagy tartomány"

msgid "Block this sender"
msgstr "Feladó blokkolása"

msgid ""
"Tags are stored on the server as IMAP keywords, so Thunderbird and other "
"clients show them too.\n"
"\n"
"Drag to reorder. The first nine are mapped to the 1–9 keys."
msgstr ""
"A címkék IMAP-kulcsszóként tárolódnak a kiszolgálón, így a Thunderbird és "
"más kliensek is megjelenítik őket.\n"
"\n"
"Húzással átrendezhetők. Az első kilenc az 1–9 billentyűkhöz van rendelve."

msgid "Add Tag…"
msgstr "Címke hozzáadása…"

msgid "Look through every mailbox for tags other clients have set"
msgstr ""
"Keressen címkéket minden olyan postafiókban, amelyeket más kliensek "
"állítottak be"

msgid "Style"
msgstr "Stílus"

msgid "Messages have their own setting under Reading."
msgstr "Az üzeneteknek saját beállításuk van az Olvasás alatt."

msgid "Text size"
msgstr "Text méret"

msgid "Adjusts the interface and message text size."
msgstr "Az felület és az üzenetek szövegméretét állítja."

msgid "Use your desktop environment's icon set"
msgstr "Az asztali környezet ikonkészletének használata"

msgid "This window opens to"
msgstr "Ez az ablak megnyílik a következő oldalon:"

msgid "Toolbar"
msgstr "Eszköztár"

msgid ""
"Drag buttons between the groups. The right group folds into ⋯ when the pane "
"is narrow."
msgstr ""
"Húzza a gombokat a csoportok között. A jobb oldali csoport ⋯ alá csukódik, "
"ha a panel szűk."

msgid "Always fold the right group into ⋯"
msgstr "A jobb oldali csoport mindig ⋯ alá csukása"

msgid "Compose in the main window"
msgstr "Levélírás a főablakban"

msgid "Off opens new messages in their own window."
msgstr "Kikapcsolva az új üzeneteket saját ablakban nyitja meg."

msgid "Reply and forward in the main window"
msgstr "Válasz és továbbítás a főablakban"

msgid "Show From, To and Subject in the reply panel"
msgstr "A „Tól”, „Kinek” és „Tárgy” mezők megjelenítése a válaszablakban"

msgid "Off folds them behind a button."
msgstr "Kikapcsolva egy gomb mögé csukja őket."

msgid "Send new messages from"
msgstr "Új üzenetek küldése a következő helyről:"

msgid "Replies answer from the address they were sent to."
msgstr "A válaszok arról a címről mennek, amelyre küldték őket."

msgid "Paste as plain text"
msgstr "Beillesztés egyszerű szövegként"

msgid "Right-clicking the editor offers both either way."
msgstr ""
"A szerkesztőn jobb gombbal kattintva mindkettő elérhető így is, úgy is."

msgid "Return starts a new paragraph"
msgstr "A „Vissza” gomb megnyomásával új bekezdés kezdődik"

msgid "Shift+Return does the other."
msgstr "A Shift+Enter a másikat adja."

msgid "Formatting toolbar"
msgstr "Formázó eszköztár"

msgid "For new messages. The toolbar's chevron toggles it."
msgstr "Új üzenetekhez. Az eszköztár nyila kapcsolja."

msgid "Always collapsed"
msgstr "Mindig összecsukva"

msgid "Always expanded"
msgstr "Mindig kibontva"

msgid "Start new messages in"
msgstr "Az új üzenetek kezdése ebben:"

msgid "For rich text. Default leaves it to the recipient's own font."
msgstr ""
"Formázott szöveghez. Az Alapértelmezett a címzett saját betűtípusára bízza."

msgid "For rich text, in points."
msgstr "Formázott szöveghez, pontban."

msgid "Default zoom"
msgstr "Alapértelmezett nagyítás"

msgid "Reply in the original's format"
msgstr "Válasz az eredeti formátumában"

msgid "Plain-text mail is answered in plain text."
msgstr "Az egyszerű szöveges levelekre egyszerű szöveggel válaszol."

msgid "Ask before switching to plain text"
msgstr "Kérdezzen, mielőtt egyszerű szövegre vált"

msgid "Only when formatting, images or links would be removed."
msgstr "Csak ha formázás, képek vagy hivatkozások eltávolításra kerülnének."

msgid "Signature in replies"
msgstr "Aláírás a válaszokban"

msgid "Separator line above the signature"
msgstr "Az aláírás feletti elválasztóvonal"

msgid "The standard “-- ” line, which other mail apps recognize."
msgstr "A szabványos „-- ” sor, amelyet más levelezőalkalmazások felismernek."

msgid "Fold quoted text"
msgstr "Idézett szöveg összecsukása"

msgid "Replies and forwards open with the original behind •••."
msgstr "A válaszok és továbbítások az eredetivel a ••• mögött nyílnak meg."

msgid "Undo Send"
msgstr "Küldés visszavonása"

msgid "How long Undo is offered after sending."
msgstr "Meddig kínálja fel a Visszavonást küldés után."

msgid "Request read receipts"
msgstr "Olvasási visszaigazolások kérése"

msgid "Returned receipts"
msgstr "Visszaérkezett visszaigazolások"

msgid "Sent mail shows who read it; the receipt goes here."
msgstr ""
"Az elküldött levelek megmutatják, ki olvasta őket; a visszaigazolás ide "
"érkezik."

msgid "Keep in Inbox"
msgstr "Megtartás a Beérkezett üzenetek között"

msgid "Reply Header"
msgstr "Válasz fejléce"

msgid "{name}, {address}, {date} and {time} are filled in from the original."
msgstr "A {name}, {address}, {date} és {time} az eredetiből töltődik ki."

msgid "Line above the quoted message"
msgstr "Az idézett üzenet feletti sor"

msgid "Restore Default"
msgstr "Alapértelmezés visszaállítása"

msgid "Attachment Reminder"
msgstr "Melléklet-emlékeztető"

msgid ""
"Send asks first when the message mentions one of these words and nothing is "
"attached."
msgstr ""
"A küldés előbb rákérdez, ha az üzenet megemlíti ezek egyikét, és nincs semmi "
"csatolva."

msgid "Words, separated by commas"
msgstr "Szavak, vesszővel elválasztva"

msgid "Spelling"
msgstr "Helyesírás"

msgid "Check spelling as you type"
msgstr "Helyesírás-ellenőrzés gépelés közben"

msgid "Right-click a word for corrections."
msgstr "Kattintson jobb gombbal egy szóra a javításokhoz."

msgid "Languages"
msgstr "Nyelvek"

msgid "Added words"
msgstr "Hozzáadott szavak"

msgid "Changes apply after a restart."
msgstr "A módosítások újraindítás után lépnek érvénybe."

msgid "Mark as read"
msgstr "Megjelölés olvasottként"

msgid "Conversations mark each message as it comes into view."
msgstr "A beszélgetések minden üzenetet megjelöl, amint láthatóvá válik."

msgid "Message appearance"
msgstr "Üzenet megjelenése"

msgid "Light / Dark Mode switch"
msgstr "Világos / sötét mód kapcsoló"

msgid "Displays in the message header for each message."
msgstr "Minden üzenetnél megjelenik az üzenetfejlécben."

msgid "Show account in message header"
msgstr "Fiók megjelenítése az üzenetfejlécben"

msgid "The account a message is in, above its subject."
msgstr "A fiók, amelyben az üzenet van, a tárgya felett."

msgid "Ctrl+0 returns to the default."
msgstr "A Ctrl+0 visszatér az alapértelmezéshez."

msgid "Use my own font"
msgstr "Saját betűtípus használata"

msgid "The font below replaces the sender's."
msgstr "Az alábbi betűtípus felülírja a feladóét."

msgid "Message font"
msgstr "Üzenet betűtípusa"

msgid "The interface font unless another is chosen."
msgstr "A kezelőfelület betűtípusa, hacsak nincs más kiválasztva."

msgid "Use my own colors"
msgstr "Saját színek használata"

msgid "Ignores the sender's colors. Pictures stay; links use the accent color."
msgstr ""
"Figyelmen kívül hagyja a feladó színeit. A képek megmaradnak; a hivatkozások "
"a kiemelőszínt használják."

msgid "Plain-text messages in monospace"
msgstr "Egyszerű szöveges üzenetek monospace betűtípussal"

msgid "Formatted messages are not affected."
msgstr "A formázott üzeneteket nem érinti."

msgid "Monospace font"
msgstr "Fix szélességű betűtípus"

msgid "The system's monospace font unless another is chosen."
msgstr ""
"A rendszer fix szélességű betűtípusa, amennyiben nincs másik választva."

msgid "Single messages as cards"
msgstr "Önálló üzenetek kártyaként"

msgid "Off fills the pane edge to edge."
msgstr "Kikapcsolva a panel szélétől szélig kitölt."

msgid "Always show recipients"
msgstr "Címzettek mindig jelenjenek meg"

msgid "Name the OpenPGP result"
msgstr "Nevezze el az OpenPGP eredményt"

msgid "Off shows the icons alone."
msgstr "Kikapcsolva csak az ikonokat mutatja."

msgid "Find bar position"
msgstr "A keresősáv helye"

msgid "A message's text alone, without the sender's layout, colors and fonts."
msgstr ""
"Csak az üzenet szövege, a feladó elrendezése, színei és betűtípusai nélkül."

msgid "Show Reader View switch in message header"
msgstr "Olvasó nézet kapcsoló megjelenítése az üzenetfejlécben"

msgid "When a message is opened"
msgstr "Amikor egy üzenetet megnyitnak"

msgid "The header's switch still changes the open message."
msgstr "A fejléc kapcsolója továbbra is a megnyitott üzenetet módosítja."

msgid "Printing"
msgstr "Nyomtatás"

msgid "Page numbers"
msgstr "Oldalszámok"

msgid "Date printed"
msgstr "Nyomtatás dátuma"

msgid "Wider left margin"
msgstr "Szélesebb bal margó"

msgid "25 mm, so punched holes miss the text."
msgstr "25 mm, hogy a lyukasztott lyukak ne érjék a szöveget."

msgid "Applies after a restart."
msgstr "Újraindítás után lép érvénybe."

msgid "Renderer"
msgstr "Megjelenítő"

msgid "Try OpenGL or Software on older graphics. Applies after a restart."
msgstr ""
"Régebbi grafikus kártyákon próbálja az OpenGL-t vagy a Szoftveres módot. "
"Újraindítás után lép érvénybe."

msgid "Keep running in the background"
msgstr "Futás a háttérben"

msgid "Closing the window hides it. Quit from Background Apps."
msgstr "Az ablak bezárása elrejti. Kilépés a Háttéralkalmazásokból."

msgid "Start at login"
msgstr "Indítás bejelentkezéskor"

msgid "Starts hidden."
msgstr "Rejtve indul."

msgid "Start fullscreen"
msgstr "Indítás teljes képernyőn"

msgid "F11 switches fullscreen on and off."
msgstr "Az F11 be- és kikapcsolja a teljes képernyőt."

msgid "Show a tray icon"
msgstr "Tálcaikon megjelenítése"

msgid "To use on GNOME, install an AppIndicator extension."
msgstr "GNOME-on való használathoz telepítsen egy AppIndicator-bővítményt."

msgid "Tray icon"
msgstr "Tálcaikon"

msgid "Unread mail in the tray menu"
msgstr "Olvasatlan levelek a tálcamenüben"

msgid "Unread count on the app icon"
msgstr "Az alkalmazás ikonján megjelenő olvasatlan üzenetek száma"

msgid "To use on GNOME, install a dock extension such as Dash to Dock."
msgstr ""
