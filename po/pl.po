msgid "Import"
msgstr "Importuj"

msgid "Mail already here is not imported again."
msgstr "Poczta, która już tu jest, nie jest importowana ponownie."

msgid "Maildir folders"
msgstr "Foldery Maildir"

msgid "Evolution's On This Computer, Dovecot and other Maildir trees."
msgstr "Na tym komputerze w Evolution, Dovecot i inne drzewa Maildir."

msgid "Mbox files"
msgstr "Pliki Mbox"

msgid "Thunderbird's folders and other mbox files."
msgstr "Foldery Thunderbirda i inne pliki mbox."

msgid "Microsoft 365"
msgstr "Microsoft 365"

msgid "Search the organization directory"
msgstr "Przeszukuj katalog organizacji"

msgid "Suggests people from your organization as you type."
msgstr "Podpowiada osoby z Twojej organizacji w trakcie pisania."

msgid "Suggest only from this account"
msgstr "Podpowiadaj tylko z tego konta"

msgid "Suggestions come from the directory and this account's mail only."
msgstr "Podpowiedzi pochodzą wyłącznie z katalogu i poczty tego konta."

