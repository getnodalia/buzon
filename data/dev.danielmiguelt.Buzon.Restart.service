# Restart helper (src/desktop/app_icon.rs): activating this name starts a fresh
# sandbox instance that waits for the running app to quit, then becomes the
# new one. Flatpak rewrites Exec to `flatpak run … --command=buzon` on export.
[D-BUS Service]
Name=dev.danielmiguelt.Buzon.Restart
Exec=/app/bin/buzon --restart-helper
